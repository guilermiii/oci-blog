# Exemplo de preenchimento para terraform.tfvars
# Copie este arquivo para terraform.tfvars e preencha com seus dados reais:
# cp terraform.tfvars.example terraform.tfvars

compartment_ocid    = "ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
region              = "sa-saopaulo-1"
oci_config_profile  = "DEFAULT"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Tags exigidas
tag_project_arm   = "Blog-do-Zeca"
tag_project_vault = "vault"
tag_project_vpn   = "VpnManagement"

# OCI Bastion Allow List
bastion_client_cidr_block_allow_list = ["0.0.0.0/0"]
