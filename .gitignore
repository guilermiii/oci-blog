# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*hcl*
*backend.tf
# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars containing personal OCIDs / paths
terraform.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
